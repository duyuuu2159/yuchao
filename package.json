{
  "name": "yuchao",
  "version": "0.1.0",
  "description": "鱼巢 AgentNest：把多个 AI agent 的本地会话管在一起的工作台",
  "type": "module",
  "license": "MIT",
  "author": "杜瑜",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "yuchao": "src/cli/main.ts"
  },
  "scripts": {
    "yuchao": "node src/cli/main.ts",
    "test": "node --test \"test/**/*.test.ts\"",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-exclude=\"test/**\" --test-coverage-exclude=\"src/cli/secret.ts\" --test-coverage-lines=90 --test-coverage-branches=80 --test-coverage-functions=85 \"test/**/*.test.ts\"",
    "bench": "node scripts/bench.ts",
    "typecheck": "tsc -p . && tsc -p web",
    "lint": "biome check",
    "format": "biome check --write",
    "check": "npm run typecheck && npm run lint && npm run test:coverage",
    "web:dev": "vite web",
    "web:build": "vite build web",
    "build:exe": "node scripts/build-exe.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "esbuild": "^0.28.2",
    "postject": "^1.0.0-alpha.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "smol-toml": "^1.9.1",
    "zod": "^4.6.7"
  }
}
